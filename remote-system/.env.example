# Public web configuration. The anon key is intentionally limited by RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Windows Agent only. Keep this value on the computer and never deploy it to the web.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
AGENT_ID=windows-desktop-01
POLL_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=30
PROCESSOR_TIMEOUT_SECONDS=3600

# Optional outbound proxy/VPN for the desktop Agent. Leave unset when the
# computer's normal HTTPS egress is acceptable.
# HTTPS_PROXY=http://127.0.0.1:7890

# Real program:
PROCESSOR_COMMAND_JSON=["my-program.exe"]

# Development fixture instead of the real program:
# PROCESSOR_COMMAND_JSON=["python","mock_processor.py"]
